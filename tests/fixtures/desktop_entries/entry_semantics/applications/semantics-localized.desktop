[Desktop Entry]
Type=Application
Name=Localized Application
Name[de]=Lokalisierte Anwendung
Name[de_DE]=Lokalisierte Anwendung (DE)
Name[sr]=Lokalizovana Aplikacija
Name[sr@latin]=Lokalizovana Aplikacija (latin)
Name[fr_CA]=Application Localisee (CA)
GenericName=Example
